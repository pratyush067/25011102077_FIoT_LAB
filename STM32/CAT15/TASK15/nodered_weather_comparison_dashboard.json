  {
    "id": "template_recommendations",
    "type": "ui_template",
    "name": "Smart Insights Card",
    "group": "grp_recommendations",
    "order": 1,
    "width": 6,
    "height": 6,
    "format": "<div style=\"padding: 12px; background: #1e293b; border-radius: 8px; color: #f8fafc;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid #334155; padding-bottom: 8px;\">\n        <span style=\"font-size: 16px; font-weight: bold;\">Microclimate Status</span>\n        <span style=\"padding: 4px 12px; border-radius: 12px; font-weight: bold; font-size: 13px; background-color: {{msg.payload.badgeColor}};\">\n            {{msg.payload.comfortBadge}}\n        </span>\n    </div>\n\n    <div style=\"margin-bottom: 12px;\">\n        <div style=\"font-size: 14px; font-weight: 600; color: #38bdf8; margin-bottom: 4px;\">Analytical Insights:</div>\n        <ul style=\"margin: 0; padding-left: 20px; font-size: 13px; color: #cbd5e1;\">\n            <li ng-repeat=\"ins in msg.payload.insights track by $index\">{{ins}}</li>\n        </ul>\n    </div>\n\n    <div>\n        <div style=\"font-size: 14px; font-weight: 600; color: #4ade80; margin-bottom: 4px;\">Smart Recommendations:</div>\n        <ul style=\"margin: 0; padding-left: 20px; font-size: 13px; color: #cbd5e1;\">\n            <li ng-repeat=\"rec in msg.payload.recommendations track by $index\">{{rec}}</li>\n        </ul>\n    </div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
