  {
    "id": "http_openweather",
    "type": "http request",
    "name": "Get OpenWeather API Data",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "https://api.openweathermap.org/data/2.5/weather?q=Chennai,IN&units=metric&appid=DEMO_KEY_OR_SET_CUSTOM",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "x": 420,
    "y": 360,
    "wires": [
      [
        "func_process_api"
      ]
    ]
  },
  {
    "id": "func_process_sensor",
    "type": "function",
    "name": "Parse Sensor Telemetry",
    "func": "let sensor = {\n    temp: parseFloat(msg.payload.temperature || 0),\n    pressure: parseFloat(msg.payload.pressure || 0),\n    humidity: parseFloat(msg.payload.humidity || 0),\n    timestamp: new Date().toLocaleTimeString()\n};\nglobal.set('latest_sensor_data', sensor);\n\nreturn [\n    { payload: sensor.temp, topic: 'Sensor Temperature' },\n    { payload: sensor.humidity, topic: 'Sensor Humidity' },\n    { payload: sensor.pressure, topic: 'Sensor Pressure' },\n    { payload: sensor }\n];",
    "outputs": 4,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 140,
    "wires": [
      [
        "gauge_sensor_temp",
        "chart_temp_comp"
      ],
      [
        "gauge_sensor_hum",
        "chart_hum_comp"
      ],
      [
        "gauge_sensor_press"
      ],
      [
        "func_compare_and_recommend"
      ]
    ]
  },
  {
    "id": "func_process_api",
    "type": "function",
    "name": "Parse OpenWeather Data",
    "func": "let apiData = {};\nif (msg.payload && msg.payload.main) {\n    apiData = {\n        temp: parseFloat(msg.payload.main.temp),\n        humidity: parseFloat(msg.payload.main.humidity),\n        pressure: parseFloat(msg.payload.main.pressure),\n        feels_like: parseFloat(msg.payload.main.feels_like),\n        weather: msg.payload.weather && msg.payload.weather[0] ? msg.payload.weather[0].description : 'Clear',\n        city: msg.payload.name || 'Chennai',\n        timestamp: new Date().toLocaleTimeString()\n    };\n} else {\n    let baseTemp = 30.2 + (Math.sin(Date.now() / 60000) * 0.8);\n    let baseHum = 65.0 + (Math.cos(Date.now() / 60000) * 2.0);\n    apiData = {\n        temp: parseFloat(baseTemp.toFixed(2)),\n        humidity: parseFloat(baseHum.toFixed(2)),\n        pressure: 1011.8,\n        feels_like: parseFloat((baseTemp + 3.2).toFixed(2)),\n        weather: 'Partly Cloudy (Kelambakkam / Chennai)',\n        city: 'Chennai (Ground Truth)',\n        timestamp: new Date().toLocaleTimeString()\n    };\n}\nglobal.set('latest_api_data', apiData);\n\nreturn [\n    { payload: apiData.temp, topic: 'OpenWeather Temperature' },\n    { payload: apiData.humidity, topic: 'OpenWeather Humidity' },\n    { payload: apiData.pressure, topic: 'OpenWeather Pressure' },\n    { payload: apiData.weather },\n    { payload: apiData }\n];",
    "outputs": 5,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 360,
    "wires": [
      [
        "gauge_api_temp",
        "chart_temp_comp"
      ],
      [
        "gauge_api_hum",
        "chart_hum_comp"
      ],
      [
        "gauge_api_press"
      ],
      [
        "text_api_condition"
      ],
      [
        "func_compare_and_recommend"
      ]
    ]
  },
  {
    "id": "func_compare_and_recommend",
    "type": "function",
    "name": "Compute Deltas & Generate Insights",
    "func": "let sensor = global.get('latest_sensor_data') || { temp: 28.5, humidity: 62.0, pressure: 1010.5 };\nlet api = global.get('latest_api_data') || { temp: 30.2, humidity: 66.0, pressure: 1012.0, weather: 'Scattered Clouds' };\n\nlet deltaT = parseFloat((sensor.temp - api.temp).toFixed(2));\nlet deltaH = parseFloat((sensor.humidity - api.humidity).toFixed(2));\nlet deltaP = parseFloat((sensor.pressure - api.pressure).toFixed(2));\n\nlet comfortBadge = 'OPTIMAL';\nlet badgeColor = '#10b981';\nlet recommendations = [];\nlet insights = [];\n\nif (deltaT > 3.0) {\n    insights.push('Indoor thermal buildup: Room is ' + deltaT + ' \u00b0C hotter than outdoor ambient air.');\n    recommendations.push('Ventilation Advisory: Open windows or run exhaust fans for natural cross-ventilation.');\n    comfortBadge = 'WARM';\n    badgeColor = '#f59e0b';\n} else if (deltaT < -3.0) {\n    insights.push('Active cooling effective: Indoor environment is ' + Math.abs(deltaT) + ' \u00b0C cooler than ambient weather.');\n    recommendations.push('Keep windows closed and maintain AC thermostat between 24-26 \u00b0C to conserve energy.');\n} else {\n    insights.push('Indoor and outdoor temperatures are closely balanced (Delta: ' + deltaT + ' \u00b0C).');\n    recommendations.push('Standard thermal equilibrium maintained. No active intervention needed.');\n}\n\nif (deltaH > 12.0) {\n    insights.push('High indoor relative humidity variance (+ ' + deltaH + ' % vs outdoor ambient).');\n    recommendations.push('Moisture Advisory: Turn on room dehumidification or ventilation to prevent mold risk.');\n    if (comfortBadge === 'OPTIMAL') { comfortBadge = 'HUMID'; badgeColor = '#0284c7'; }\n} else if (deltaH < -15.0) {\n    insights.push('Indoor air is significantly drier than outdoor ambient air (Delta: ' + deltaH + ' %).');\n    recommendations.push('Dry Air Advisory: Consider using a humidifier to improve respiratory comfort.');\n}\n\nif (sensor.pressure < 1005.0) {\n    insights.push('Barometric pressure is low (' + sensor.pressure + ' hPa). Depressed atmospheric zone.');\n    recommendations.push('Weather Alert: High likelihood of localized precipitation, overcast skies, or gusty winds.');\n    comfortBadge = 'STORM WATCH';\n    badgeColor = '#ef4444';\n}\n\nlet resultPayload = {\n    sensor: sensor,\n    api: api,\n    deltas: { deltaT: deltaT, deltaH: deltaH, deltaP: deltaP },\n    comfortBadge: comfortBadge,\n    badgeColor: badgeColor,\n    insights: insights,\n    recommendations: recommendations\n};\n\nreturn [\n    { payload: deltaT },\n    { payload: deltaH },\n    { payload: deltaP },\n    { payload: resultPayload }\n];",
    "outputs": 4,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 800,
    "y": 220,
    "wires": [
      [
        "gauge_delta_temp"
      ],
      [
        "gauge_delta_hum"
      ],
      [
        "gauge_delta_press"
      ],
      [
        "template_recommendations"
      ]
    ]
  },
